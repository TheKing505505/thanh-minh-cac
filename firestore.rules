rules_version = '2';
// =====================================================================
//  FIRESTORE SECURITY RULES — Thanh Minh Các (bản bảo mật)
//  Nguyên tắc:
//   1) Mặc định TỪ CHỐI tất cả. Không có rule "match /{document=**}".
//   2) Khách chỉ đọc/ghi dữ liệu CỦA CHÍNH MÌNH (so khớp request.auth.uid).
//   3) Khách KHÔNG BAO GIỜ được ghi balance / role / titleOverride — chỉ admin.
//      (Trừ/cộng tiền do admin làm bằng transaction trong trình duyệt admin.)
//   4) Chỉ admin (đúng 1 UID) đọc được toàn bộ đơn, thẻ, người dùng.
//  Áp dụng: Firebase Console → Firestore Database → Rules → dán → Publish.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Hàm dùng chung ----------
    function isSignedIn() { return request.auth != null; }

    // ⚠️ ĐỔI thành UID tài khoản admin của bạn (Firebase Console → Authentication → Users).
    function isAdmin() {
      return isSignedIn() && request.auth.uid == "dZ1j9g4vVcSDlGDtRIEkQlY7Vbt1";
    }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    function nowMs() { return request.time.toMillis(); }
    // timestamp do client gửi phải gần giờ máy chủ (chống lùi/ tiến ngày bừa bãi)
    function freshTs(ts) { return ts is number && ts > nowMs() - 600000 && ts < nowMs() + 600000; }

    // chuỗi tuỳ chọn: vắng mặt hoặc là string ≤ max
    function optStr(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
    // chuỗi tuỳ chọn cho phép null
    function optStrNull(d, k, max) { return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= max); }
    function isNullOrAbsent(d, k) { return !(k in d) || d[k] == null; }

    // tên hiển thị trong đơn/thẻ/yêu cầu phải đúng với hồ sơ của chính người gửi
    function myUsername() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username;
    }

    // ---------- Hồ sơ người dùng ----------
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // Tự tạo hồ sơ MỘT LẦN, với số dư 0, vai trò user, không danh hiệu,
      // và phải đi kèm đúng 1 tài liệu giữ chỗ tên đăng nhập (usernames/…).
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['uid','username','usernameLower','email','facebook','titleOverride','balance','role','createdAt','createdAtTs'])
        && request.resource.data.keys().hasAll(['uid','username','usernameLower','titleOverride','balance','role'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.balance == 0
        && request.resource.data.role == 'user'
        && request.resource.data.titleOverride == null
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 2 && request.resource.data.username.size() <= 20
        && request.resource.data.usernameLower is string
        && request.resource.data.usernameLower.size() >= 2 && request.resource.data.usernameLower.size() <= 20
        && request.resource.data.usernameLower != 'thanh minh các chủ'
        && optStr(request.resource.data, 'email', 100)
        && optStr(request.resource.data, 'facebook', 200)
        && existsAfter(/databases/$(database)/documents/usernames/$('n_' + request.resource.data.usernameLower))
        && getAfter(/databases/$(database)/documents/usernames/$('n_' + request.resource.data.usernameLower)).data.uid == request.auth.uid;

      // Khách chỉ được sửa email/facebook của mình. Mọi trường khác (balance, role, title…) bị chặn.
      allow update: if isAdmin()
        || (isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email','facebook'])
            && optStr(request.resource.data, 'email', 100)
            && optStr(request.resource.data, 'facebook', 200));

      allow delete: if isAdmin();
    }

    // ---------- Giữ chỗ tên đăng nhập (đảm bảo không trùng tên) ----------
    match /usernames/{name} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid','usernameLower'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.usernameLower is string
        && request.resource.data.usernameLower.size() >= 2 && request.resource.data.usernameLower.size() <= 20
        && name == 'n_' + request.resource.data.usernameLower
        // chỉ được tạo khi đồng thời tạo hồ sơ khớp tên (chống chiếm tên hàng loạt)
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower == request.resource.data.usernameLower;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- Đơn hàng (chứa thông tin tài khoản Roblox của khách) ----------
    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isSignedIn()
        && orderId.matches('TMC-[A-Z0-9]{10}')
        && request.resource.data.keys().hasOnly(['id','uid','username','serviceId','serviceName','serviceCode','price','origPrice','discountInfo','subOption','account','password','passwordEnc','note','time','timestamp','status','doneTime','doneMessage'])
        && request.resource.data.keys().hasAll(['id','uid','username','serviceId','serviceName','price','origPrice','account','time','timestamp','status'])
        && request.resource.data.id == orderId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == myUsername()
        && request.resource.data.status == 'pending'
        && request.resource.data.serviceId is number
        && request.resource.data.serviceName is string && request.resource.data.serviceName.size() <= 200
        && request.resource.data.price is number && request.resource.data.price >= 0 && request.resource.data.price <= 100000000
        && request.resource.data.origPrice is number && request.resource.data.origPrice >= 0 && request.resource.data.origPrice <= 100000000
        && request.resource.data.account is string && request.resource.data.account.size() >= 1 && request.resource.data.account.size() <= 60
        && request.resource.data.time is string && request.resource.data.time.size() <= 60
        && ('password' in request.resource.data || 'passwordEnc' in request.resource.data)
        && optStr(request.resource.data, 'password', 100)
        && optStr(request.resource.data, 'passwordEnc', 700)
        && optStr(request.resource.data, 'note', 300)
        && optStr(request.resource.data, 'serviceCode', 40)
        && optStrNull(request.resource.data, 'subOption', 100)
        && optStrNull(request.resource.data, 'discountInfo', 100)
        && isNullOrAbsent(request.resource.data, 'doneTime')
        && isNullOrAbsent(request.resource.data, 'doneMessage')
        && freshTs(request.resource.data.timestamp);

      allow update, delete: if isAdmin();   // khách không sửa/xoá đơn sau khi tạo
    }

    // ---------- Thẻ nạp (chứa seri + mã thẻ — cực nhạy cảm) ----------
    match /cards/{cardId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isSignedIn()
        && cardId.matches('CARD-[A-Z0-9]{12}')
        && request.resource.data.keys().hasOnly(['id','uid','username','type','denom','serial','code','time','timestamp','status','note'])
        && request.resource.data.keys().hasAll(['id','uid','username','type','denom','serial','code','time','timestamp','status'])
        && request.resource.data.id == cardId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == myUsername()
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['Viettel','Mobifone','Vinaphone','Zing','Garena','Vietnamobile']
        && request.resource.data.denom in [10000,20000,50000,100000,200000,500000]
        && request.resource.data.serial is string && request.resource.data.serial.size() >= 5 && request.resource.data.serial.size() <= 40
        && request.resource.data.code is string && request.resource.data.code.size() >= 5 && request.resource.data.code.size() <= 40
        && request.resource.data.time is string && request.resource.data.time.size() <= 60
        && (!('note' in request.resource.data) || request.resource.data.note == '')
        && freshTs(request.resource.data.timestamp);

      allow update, delete: if isAdmin();   // chỉ admin duyệt/từ chối
    }

    // ---------- Yêu cầu mua danh hiệu ----------
    match /titlepurchases/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isSignedIn()
        && id.matches('[A-Za-z0-9]{20}')
        && request.resource.data.keys().hasOnly(['uid','username','titleId','titleName','price','origPrice','renewalType','time','timestamp','status'])
        && request.resource.data.keys().hasAll(['uid','username','titleId','titleName','price','origPrice','renewalType','time','timestamp','status'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == myUsername()
        && request.resource.data.status == 'pending'
        && request.resource.data.titleId in ['truc-co','kim-dan','nguyen-anh','hoa-than','luyen-hu','hop-the','dai-thua','do-kiep']
        && request.resource.data.renewalType in ['new','early','grace','full']
        && request.resource.data.titleName is string && request.resource.data.titleName.size() <= 60
        && request.resource.data.price is number && request.resource.data.price >= 0 && request.resource.data.price <= 10000000
        && request.resource.data.origPrice is number && request.resource.data.origPrice >= 0 && request.resource.data.origPrice <= 10000000
        && request.resource.data.time is string && request.resource.data.time.size() <= 60
        && freshTs(request.resource.data.timestamp);

      allow update, delete: if isAdmin();
    }

    // ---------- Nhật ký cộng/trừ tiền ----------
    match /coinlogs/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }

    // ---------- Dữ liệu CÔNG KHAI (ai cũng đọc, chỉ admin ghi) ----------
    match /fruitstock/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /public_stats/{id}  { allow read: if true; allow write: if isAdmin(); }

    // ---------- Cấu hình nội bộ ----------
    match /system_configs/{id} { allow read, write: if isAdmin(); }

    // Mọi đường dẫn khác: mặc định TỪ CHỐI (không cần viết thêm).
  }
}
