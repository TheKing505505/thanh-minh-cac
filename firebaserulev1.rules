rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // UID nay duoc copy tu firebaserulev1.rules cu.
    // Phai doi neu no khong phai UID Firebase Authentication cua chu shop.
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == 'MiiCu1YFHKOwhVcB48OAxR8ImRg2';
    }

    // Tai khoan khach phai co users/{username} voi uid trung Auth UID.
    function ownsProfile(username) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(username))
        && get(/databases/$(database)/documents/users/$(username)).data.uid == request.auth.uid;
    }

    match /users/{username} {
      // Chu shop doc duoc tat ca; khach chi doc ho so cua chinh minh.
      allow get, list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      // Tao ho so moi sau khi dang ky Firebase Authentication.
      // Khong cho phep tu tao role admin, so du, hoac passwordHash.
      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'email', 'facebook', 'titleOverride',
          'createdAt', 'createdAtTs', 'balance', 'role'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'username', 'email', 'facebook', 'createdAtTs', 'balance', 'role'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && request.resource.data.role == 'user'
        && request.resource.data.balance == 0
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.facebook is string
        && request.resource.data.facebook.size() <= 256
      );

      // Khach chi duoc sua thong tin lien he. Balance/role/danh hieu do admin quan ly.
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == resource.data.username
        && request.resource.data.role == resource.data.role
        && request.resource.data.balance == resource.data.balance
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.facebook is string
        && request.resource.data.facebook.size() <= 256
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'facebook'])
      );

      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      // Don hang moi phai gan voi tai khoan da xac thuc va ho so cua chinh khach.
      allow create: if signedIn()
        && ownsProfile(request.resource.data.username)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.id == orderId
        && request.resource.data.status == 'pending'
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.origPrice is number
        && request.resource.data.origPrice >= 0
        && request.resource.data.account is string
        && request.resource.data.account.size() > 0
        && request.resource.data.account.size() <= 128
        && request.resource.data.serviceName is string
        && request.resource.data.serviceName.size() <= 128
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1000
        && request.resource.data.password is string
        && request.resource.data.password.size() > 0
        && request.resource.data.password.size() <= 256
        && request.resource.data.timestamp is number
        && request.resource.data.keys().hasAll([
          'id', 'uid', 'username', 'serviceId', 'serviceName', 'serviceCode',
          'price', 'origPrice', 'discountInfo', 'subOption', 'account',
          'password', 'note', 'time', 'timestamp', 'status', 'doneTime', 'doneMessage'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'uid', 'username', 'serviceId', 'serviceName', 'serviceCode',
          'price', 'origPrice', 'discountInfo', 'subOption', 'account',
          'password', 'note', 'time', 'timestamp', 'status', 'doneTime', 'doneMessage'
        ]);

      // Chi chu shop duoc sua trang thai/ghi chu hoan thanh/xoa don.
      allow update, delete: if isAdmin();
    }

    match /cards/{cardId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if signedIn()
        && ownsProfile(request.resource.data.username)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.id == cardId
        && request.resource.data.status == 'pending'
        && request.resource.data.denom is number
        && request.resource.data.denom > 0
        && request.resource.data.denom <= 500000
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 64
        && request.resource.data.type is string
        && request.resource.data.type.size() <= 32
        && request.resource.data.serial is string
        && request.resource.data.serial.size() > 0
        && request.resource.data.serial.size() <= 64
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.code.size() <= 128
        && request.resource.data.timestamp is number
        && request.resource.data.keys().hasAll([
          'id', 'uid', 'username', 'type', 'denom', 'serial', 'code',
          'time', 'timestamp', 'status', 'note'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'uid', 'username', 'type', 'denom', 'serial', 'code',
          'time', 'timestamp', 'status', 'note'
        ]);

      allow update, delete: if isAdmin();
    }

    match /titlepurchases/{purchaseId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if signedIn()
        && ownsProfile(request.resource.data.username)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 64
        && request.resource.data.titleId is string
        && request.resource.data.titleId.size() <= 64
        && request.resource.data.titleName is string
        && request.resource.data.titleName.size() <= 128
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.origPrice is number
        && request.resource.data.origPrice >= 0
        && request.resource.data.timestamp is number
        && request.resource.data.keys().hasAll([
          'uid', 'username', 'titleId', 'titleName', 'price', 'origPrice',
          'renewalType', 'time', 'timestamp', 'status'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'titleId', 'titleName', 'price', 'origPrice',
          'renewalType', 'time', 'timestamp', 'status'
        ]);

      allow update, delete: if isAdmin();
    }

    // Bang ton kho duoc doc cong khai de hien thi tinh trang trai.
    // Chi chu shop duoc cap nhat so luong.
    match /fruitstock/{stockId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Log nap/rut tien la du lieu noi bo, khong cong khai cho khach.
    match /coinlogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Chua co luong client can doc collection nay; mac dinh chi admin.
    match /system_configs/{configId} {
      allow read, write: if isAdmin();
    }

    // Khong co catch-all cho phep doc/ghi. Moi collection khac mac dinh bi tu choi.
  }
}
